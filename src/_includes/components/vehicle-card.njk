{% set cardImage = item.data.cover_image | safeMedia(item.data.cover_source, '/assets/uploads/placeholder.svg') %}
<article class="bk-journey-card">
  <a class="bk-card-media" href="{{ item.url }}"><img src="{{ cardImage }}"{{ cardImage | srcsetAttr('(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 420px') | safe }} alt="{{ item.data.title }}" width="800" height="500" loading="lazy" decoding="async"><span class="bk-card-type">Vehicle</span></a>
  <div class="bk-card-body"><h3><a href="{{ item.url }}">{{ item.data.title }}</a></h3><p>{{ item.data.summary }}</p><div class="bk-card-meta">{% if item.data.price_from %}<span>{{ item.data.price_from }}</span>{% endif %}{% if item.data.max_people %}<span>Up to {{ item.data.max_people }}</span>{% endif %}</div></div>
  <div class="bk-card-actions"><a href="{{ item.url }}">View details</a><a class="bk-book-button" href="/plan-a-trip/?journey={{ item.data.title | urlencode }}&service=Vehicle%20Rental#trip-request-form">Book now</a></div>
</article>

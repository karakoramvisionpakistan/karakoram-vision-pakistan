{% set has_generated_facts = duration or price_from or destination or difficulty %}
{% if answer_summary or summary or (key_facts and key_facts.length) or has_generated_facts %}
<section class="answer-block cv-auto" aria-labelledby="quick-answer-heading">
  <p class="eyebrow">Quick answer</p>
  <h2 id="quick-answer-heading" class="mt-2 text-2xl font-black text-slate-950">{{ answer_heading or ('What to know about ' + title) }}</h2>
  {% if answer_summary or summary %}<p class="mt-3 text-lg leading-8 text-slate-700">{{ answer_summary or summary }}</p>{% endif %}
  {% if (key_facts and key_facts.length) or has_generated_facts %}
  <dl class="mt-6 grid gap-3 sm:grid-cols-2">
    {% if duration %}<div class="rounded-lg border border-slate-200 bg-white p-4"><dt class="text-xs font-black uppercase tracking-wider text-blue-800">Duration</dt><dd class="mt-1 font-semibold text-slate-950">{{ duration }}</dd></div>{% endif %}
    {% if price_from %}<div class="rounded-lg border border-slate-200 bg-white p-4"><dt class="text-xs font-black uppercase tracking-wider text-blue-800">Indicative price</dt><dd class="mt-1 font-semibold text-slate-950">{% set priceText = price_from | string | trim %}{% if priceText | lower == 'on request' or priceText | lower == 'on-request' %}{{ priceText }}{% else %}From {{ priceText }}{% endif %}</dd></div>{% endif %}
    {% if destination %}<div class="rounded-lg border border-slate-200 bg-white p-4"><dt class="text-xs font-black uppercase tracking-wider text-blue-800">Destination</dt><dd class="mt-1 font-semibold text-slate-950">{{ destination }}</dd></div>{% endif %}
    {% if difficulty %}<div class="rounded-lg border border-slate-200 bg-white p-4"><dt class="text-xs font-black uppercase tracking-wider text-blue-800">Difficulty</dt><dd class="mt-1 font-semibold text-slate-950">{{ difficulty }}</dd></div>{% endif %}
    {% for fact in key_facts or [] %}<div class="rounded-lg border border-slate-200 bg-white p-4"><dt class="text-xs font-black uppercase tracking-wider text-blue-800">{{ fact.label }}</dt><dd class="mt-1 font-semibold text-slate-950">{{ fact.value }}</dd></div>{% endfor %}
  </dl>
  {% endif %}
</section>
{% endif %}

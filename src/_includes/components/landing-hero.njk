{# Hero banner.

   CMS se control: "Big banner" wali screen par har page ke liye teen surtein -
   slider chalu, ya slider band + ek jami hui photo, ya slider band aur sirf ek
   saada patti. Teenon mein page ka unwaan (h1) rehta hai, kyunke usey gayab
   karna Google ke liye nuqsan-deh hai.

   Banner chalu ho to do tareeqe se chalta hai:
   1. Client ne CMS ke "Hero Sliders" mein us section ki slides banayi hon to
      wahi dikhti hain - har slide ki apni photo, heading, text aur button.
   2. Warna purana khud-kar slider chalta hai jo journeys ki cover photos uthata hai.

   PHOTO KI SHAKAL
   Har photo ki teen katayein pehle se bani hoti hain - bari screen ke liye
   chauri, tablet ke liye darmiyani, mobile ke liye lambi. Browser apni screen
   ke mutabiq sahi wali uthata hai. Na kuch khinchta hai, na koi khali patti
   banti hai, aur mobile par chhoti file utarti hai to page tez khulta hai.
   Katai tools/hero-crops.mjs banata hai; fehrist src/_data/heroImages.json
   mein hoti hai. Kisi photo ki katai na bani ho to asli photo chal jati hai. #}
{% set heroPageKey = page.url | heroKey %}
{% set heroCfg = heroSettings | heroConfig(heroPageKey) %}

{% if not heroCfg.enabled and heroCfg.image %}
  {# Slider band hai lekin client ne ek photo lagai hai - wahi jami hui dikhao.
     Markup slider jaisa hi hai, bas data-hero-slider nahi, to JS isey nahi chhuta. #}
  {% set staticImage = heroCfg.image | safeMedia('', '/assets/uploads/placeholder.svg') %}
  {% set staticAlt = heroCfg.image_alt or heroHeading or title %}
  {% set staticPic = heroImages | heroPicture(staticImage) %}
  <section class="bk-hero bk-hero-compact">
    <div class="bk-hero-stage">
      <article class="bk-hero-slide is-active">
        {% if staticPic %}
        <picture>
          <source media="(max-width: 767px)" sizes="100vw" srcset="{{ staticPic.tall }}">
          <source media="(max-width: 1279px)" sizes="100vw" srcset="{{ staticPic.mid }}">
          <source sizes="100vw" srcset="{{ staticPic.wide }}">
          <img class="bk-hero-photo" src="{{ staticPic.fallback }}" alt="{{ staticAlt }}" width="{{ staticPic.w }}" height="{{ staticPic.h }}" fetchpriority="high" decoding="async">
        </picture>
        {% else %}
        <img class="bk-hero-photo" src="{{ staticImage }}" alt="{{ staticAlt }}" width="1920" height="1080" fetchpriority="high" decoding="async">
        {% endif %}
        <div class="bk-hero-shade"></div>
        <div class="bk-hero-copy">
          <p class="bk-hero-eyebrow">{{ heroEyebrow or site.tagline or site.name }}</p>
          <h1>{{ heroHeading or title }}</h1>
          {% if heroSummary or summary %}<p class="bk-hero-summary">{{ heroSummary or summary }}</p>{% endif %}
        </div>
      </article>
    </div>
    {% if heroFinder %}<div class="bk-hero-finder-wrap">{% include "components/trip-finder.njk" %}</div>{% endif %}
  </section>

{% elif not heroCfg.enabled %}
  {# Slider bhi band aur photo bhi nahi - saada patti. Unwaan phir bhi rehta hai. #}
  <section class="bk-page-header">
    <div class="bk-page-header-inner">
      <p class="eyebrow">{{ heroEyebrow or site.tagline or site.name }}</p>
      <h1>{{ heroHeading or title }}</h1>
      {% if heroSummary or summary %}<p>{{ heroSummary or summary }}</p>{% endif %}
    </div>
    {% if heroFinder %}<div class="bk-page-header-finder">{% include "components/trip-finder.njk" %}</div>{% endif %}
  </section>

{% else %}

{% set sliderKey = heroSection or service_type or 'homepage' %}
{% set customSlides = collections.sliders | slidesFor(sliderKey) %}
{% set autoSlides = heroItems | limit(6) %}
{% set useCustom = customSlides.length > 0 %}
{% set slides = customSlides if useCustom else autoSlides %}
<section class="bk-hero{% if heroCompact %} bk-hero-compact{% endif %}" data-hero-slider data-autoplay="6500" aria-label="{{ heroHeading or title }} featured journeys">
  <div class="bk-hero-stage">
    {% for item in slides %}
      {% if useCustom %}
        {% set slideImage = item.data.image | safeMedia('', '/assets/uploads/placeholder.svg') %}
        {% set slideHeading = item.data.heading or heroHeading or title %}
        {% set slideAlt = item.data.image_alt or item.data.heading or item.data.title %}
      {% else %}
        {% set slideImage = item.data.cover_image | safeMedia(item.data.cover_source, '/assets/uploads/placeholder.svg') %}
        {% set slideHeading = heroHeading or title %}
        {% set slideAlt = item.data.cover_image_alt or item.data.title %}
      {% endif %}
      {% set slidePic = heroImages | heroPicture(slideImage) %}
      <article class="bk-hero-slide{% if loop.first %} is-active{% elif loop.index0 == 1 %} is-next{% elif loop.last %} is-prev{% endif %}" data-hero-slide data-index="{{ loop.index0 }}" aria-hidden="{{ 'false' if loop.first else 'true' }}">
        {% if slidePic %}
        <picture>
          <source media="(max-width: 767px)" sizes="100vw" srcset="{{ slidePic.tall }}">
          <source media="(max-width: 1279px)" sizes="100vw" srcset="{{ slidePic.mid }}">
          <source sizes="100vw" srcset="{{ slidePic.wide }}">
          <img class="bk-hero-photo" src="{{ slidePic.fallback }}" alt="{{ slideAlt }}" width="{{ slidePic.w }}" height="{{ slidePic.h }}" {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
        </picture>
        {% else %}
        <img class="bk-hero-photo" src="{{ slideImage }}" alt="{{ slideAlt }}" width="1920" height="1080" {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
        {% endif %}
        <div class="bk-hero-shade"></div>
        <div class="bk-hero-copy">
          {% if useCustom %}
            <p class="bk-hero-eyebrow">{{ item.data.eyebrow or heroEyebrow or site.tagline or site.name }}</p>
            {% if loop.first %}<h1>{{ slideHeading }}</h1>{% else %}<h2>{{ slideHeading }}</h2>{% endif %}
            {% if item.data.text %}<p class="bk-hero-summary">{{ item.data.text }}</p>{% endif %}
            <div class="bk-hero-actions">
              {% if item.data.button_url %}<a class="bk-hero-primary" href="{{ item.data.button_url }}">{{ item.data.button_label or 'View details' }}</a>{% endif %}
              <a class="bk-hero-secondary" href="/plan-a-trip/#trip-request-form">Plan a trip</a>
            </div>
          {% else %}
            <p class="bk-hero-eyebrow">{{ heroEyebrow or item.data.service_label or 'Karakoram Vision Pakistan' }}</p>
            {% if loop.first %}<h1>{{ slideHeading }}</h1>{% else %}<h2>{{ slideHeading }}</h2>{% endif %}
            <p class="bk-hero-feature-title">{{ item.data.title }}</p>
            <p class="bk-hero-summary">{{ heroSummary or summary or item.data.summary }}</p>
            <div class="bk-hero-actions">
              <a class="bk-hero-primary" href="{{ item.url }}">View details</a>
              <a class="bk-hero-secondary" href="/plan-a-trip/?journey={{ item.data.title | urlencode }}&service={{ item.data.service_type | urlencode }}#trip-request-form">Book now</a>
            </div>
          {% endif %}
        </div>
      </article>
    {% else %}
      <article class="bk-hero-slide is-active" data-hero-slide data-index="0" aria-hidden="false">
        <img class="bk-hero-photo" src="/assets/uploads/placeholder.svg" alt="Karakoram Vision Pakistan mountain journey" width="1920" height="1080" fetchpriority="high" decoding="async">
        <div class="bk-hero-shade"></div>
        <div class="bk-hero-copy"><p class="bk-hero-eyebrow">Karakoram Vision Pakistan</p><h1>{{ heroHeading or title }}</h1><p class="bk-hero-summary">{{ heroSummary or summary }}</p><div class="bk-hero-actions"><a class="bk-hero-primary" href="/plan-a-trip/#trip-request-form">Plan a trip</a></div></div>
      </article>
    {% endfor %}
  </div>
  {% if slides.length > 1 %}
  <button class="bk-hero-control bk-hero-prev" type="button" data-hero-prev aria-label="Previous slide">‹</button>
  <button class="bk-hero-control bk-hero-next" type="button" data-hero-next aria-label="Next slide">›</button>
  <div class="bk-hero-dots" role="tablist" aria-label="Choose slide">
    {% for item in slides %}<button type="button" data-hero-dot data-index="{{ loop.index0 }}" class="{% if loop.first %}is-active{% endif %}" aria-label="Show slide {{ loop.index }}" aria-selected="{{ 'true' if loop.first else 'false' }}"></button>{% endfor %}
  </div>
  {% endif %}
  {% if heroFinder %}<div class="bk-hero-finder-wrap">{% include "components/trip-finder.njk" %}</div>{% endif %}
</section>
{% endif %}

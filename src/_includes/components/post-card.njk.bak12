{% set cardImage = item.data.cover_image | safeMedia(item.data.cover_source, '/assets/uploads/placeholder.svg') %}
<article class="bk-journey-card">
  <a class="bk-card-media" href="{{ item.url }}"><img src="{{ cardImage }}"{{ cardImage | srcsetAttr('(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 420px') | safe }} alt="{{ item.data.title }}" width="800" height="500" loading="lazy" decoding="async"><span class="bk-card-type">Travel guide</span></a>
  <div class="bk-card-body"><h3><a href="{{ item.url }}">{{ item.data.title }}</a></h3><p>{{ item.data.summary }}</p></div>
  <div class="bk-card-actions"><a class="bk-book-button" href="{{ item.url }}">Read guide</a></div>
</article>

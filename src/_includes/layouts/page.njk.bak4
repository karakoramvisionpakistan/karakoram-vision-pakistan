---
layout: layouts/base.njk
---
<section class="border-b border-slate-200 bg-slate-50 py-16"><div class="mx-auto max-w-7xl px-4"><p class="eyebrow">{{ site.name }}</p><h1 class="mt-3 max-w-4xl text-4xl font-black leading-tight md:text-6xl">{{ title }}</h1>{% if summary %}<p class="mt-5 max-w-3xl text-lg text-slate-600">{{ summary }}</p>{% endif %}</div></section>
<div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 lg:grid-cols-[minmax(0,1fr)_340px]"><article x-data="contentEnhancer" class="min-w-0">{% include "components/answer-block.njk" %}<div class="prose-clean mt-10">{{ content | safe }}</div>{% include "components/faq-block.njk" %}{% include "components/trust-block.njk" %}</article><aside class="h-max rounded-xl border border-slate-200 bg-slate-50 p-6 lg:sticky lg:top-28"><p class="eyebrow">Plan your journey</p><h2 class="mt-2 text-2xl font-black">Ask our travel team</h2><p class="mt-3 text-slate-600">Get dates, pricing and a private itinerary.</p>{% include "components/contact-buttons.njk" %}</aside></div>

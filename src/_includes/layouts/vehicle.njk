---
layout: layouts/base.njk
---
<section class="bg-slate-950 py-16 text-white"><div class="mx-auto max-w-7xl px-4"><p class="eyebrow text-blue-200">Vehicle</p><h1 class="mt-3 text-4xl font-black md:text-6xl">{{ title }}</h1><p class="mt-5 max-w-3xl text-slate-200">{{ summary }}</p></div></section>
{% set vehicleImage = cover_image | safeMedia(cover_source, '') %}
<div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 lg:grid-cols-[minmax(0,1fr)_340px]"><article x-data="contentEnhancer" class="min-w-0">{% if vehicleImage and vehicleImage != '/assets/uploads/placeholder.svg' %}<img class="mb-10 aspect-[16/9] max-h-[580px] w-full rounded-xl object-cover" src="{{ vehicleImage }}"{{ vehicleImage | srcsetAttr('(max-width: 1023px) 100vw, 1000px') | safe }} alt="{{ title }}" width="1400" height="788" fetchpriority="high" decoding="async">{% endif %}{% include "components/answer-block.njk" %}<div class="prose-clean mt-10">{{ content | safe }}</div>{% include "components/faq-block.njk" %}{% include "components/trust-block.njk" %}</article><aside class="h-max rounded-xl border border-slate-200 bg-slate-50 p-6 lg:sticky lg:top-36"><p class="eyebrow">Vehicle inquiry</p><h2 class="mt-2 text-2xl font-black">Request this vehicle</h2><a href="/plan-a-trip/#trip-request-form" data-open-plan-trip class="btn-primary mt-5 w-full">Request vehicle</a>{% include "components/contact-buttons.njk" %}</aside></div>

---
layout: layouts/base.njk
---
<section class="bg-slate-950 py-16 text-white"><div class="mx-auto max-w-5xl px-4"><p class="eyebrow text-blue-200">Travel guide</p><h1 class="mt-3 text-4xl font-black md:text-6xl">{{ title }}</h1><p class="mt-5 max-w-3xl text-slate-200">{{ summary }}</p></div></section>
{% set postImage = cover_image | safeMedia(cover_source, '') %}
<article x-data="contentEnhancer" class="mx-auto max-w-5xl px-4 py-14">{% if postImage and postImage != '/assets/uploads/placeholder.svg' %}<img class="mb-10 aspect-[16/9] max-h-[600px] w-full rounded-xl object-cover" src="{{ postImage }}"{{ postImage | srcsetAttr('(max-width: 1023px) 100vw, 1000px') | safe }} alt="{{ title }}" width="1400" height="788" fetchpriority="high" decoding="async">{% endif %}{% include "components/answer-block.njk" %}<div class="prose-clean mt-10">{{ content | safe }}</div>{% include "components/faq-block.njk" %}{% include "components/trust-block.njk" %}</article>

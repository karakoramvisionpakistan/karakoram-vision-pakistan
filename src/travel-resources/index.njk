{% set lp = landing[page.url] or {} %}

<section class="bk-page-hero-simple"><div><p class="eyebrow">{{ lp.hero_eyebrow or 'Prepare with confidence' }}</p><h1>{{ lp.title or 'Travel Resources' }}</h1><p>{{ lp.summary or 'Use these guides as a starting point for fitness, gear, insurance, health, visas, altitude and responsible mountain travel. Final requirements vary by route and season.' }}</p></div></section>
<section class="bk-resources-shell"><div class="bk-resource-grid">
  {% set resources = (lp.cards or [
{"title":"Trip preparedness","description":"Fitness, training and realistic expectations for active journeys.","url":"/search/?type=blog&q=preparation"},
{"title":"Gear & packing","description":"Layering, footwear, sleeping systems and technical equipment.","url":"/search/?type=blog&q=packing"},
{"title":"Travel insurance","description":"Coverage considerations for trekking, altitude and evacuation.","url":"/search/?type=blog&q=insurance"},
{"title":"Health & altitude","description":"Acclimatization, hydration, medication discussions and warning signs.","url":"/search/?type=blog&q=altitude"},
{"title":"Pakistan travel information","description":"Transport, culture, money, connectivity and arrival guidance.","url":"/international-travelers/"},
{"title":"Permits & compliance","description":"Route permits, restricted areas, climbing and wildlife programme rules.","url":"/contact-us/"},
{"title":"Responsible travel","description":"Local communities, conservation, waste and respectful conduct.","url":"/social-responsibility/"},
{"title":"Frequently asked questions","description":"Fast answers about bookings, groups, safety and customization.","url":"/faqs/"},
{"title":"Vehicles & logistics","description":"Road transfers, expedition cargo and mountain-access transport.","url":"/vehicles/"}
]) | liveCards %}
  {% for resource in resources %}<article class="bk-resource-card"><span>Resource {{ loop.index }}</span><h2>{{ resource.title }}</h2><p>{{ resource.description }}</p><a href="{{ resource.url }}">Open resource →</a></article>{% endfor %}
</div><section class="bk-home-contact"><div><p class="eyebrow">{{ lp.section_eyebrow or 'Need a specific answer?' }}</p><h2>{{ lp.section_heading or 'Talk directly with the travel team' }}</h2><p>{{ lp.section_intro or 'Choose email, phone, WhatsApp, Telegram, Messenger, LINE, WeChat, Viber, KakaoTalk, VK or another configured channel.' }}</p></div><button type="button" class="btn-primary" data-open-contact>Choose contact app</button></section></section>

{% set heroItems = collections.journeys | limit(6) %}{% set heroHeading = title %}{% set heroSummary = summary %}{% set heroEyebrow = 'Traveler experiences' %}{% set heroCompact = true %}
{% include "components/landing-hero.njk" %}
<section class="mx-auto max-w-5xl px-4 pt-12"><h2 class="text-2xl font-black">What our guests say</h2>
<div data-reviews-list class="mt-6 grid gap-5 md:grid-cols-2"></div>
<p data-reviews-empty hidden class="mt-6 text-slate-600">Reviews from our guests will appear here soon.</p></section>
<section id="submit-review" class="mx-auto max-w-3xl px-4 py-12"><div class="rounded-2xl border border-blue-100 bg-blue-50 p-6 md:p-9">
<h2 class="text-2xl font-black">Share your experience</h2>
<p class="mt-3 text-slate-700">Travelled with Karakoram Vision Pakistan? We would love to hear how it went. Our team reads every review before it appears on this page.</p>
<form action="/api/trip-request" method="post" data-site-form data-review-form class="mt-6 grid gap-5 md:grid-cols-2">
<input type="hidden" name="_type" value="review"><input type="hidden" name="_next" value="/guest-reviews/">
<label class="block text-sm font-bold">Full name<input required name="full_name" autocomplete="name" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-normal"></label>
<label class="block text-sm font-bold">Email<input required type="email" name="email" autocomplete="email" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-normal"></label>
<label class="block text-sm font-bold">Country<input name="country" autocomplete="country-name" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-normal"></label>
<label class="block text-sm font-bold">Journey / package you took<input required name="journey" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-normal"></label>
<label class="block text-sm font-bold">When did you travel? (month and year)<input name="travel_date" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-normal"></label>
<label class="block text-sm font-bold">Rating<select required name="rating" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-normal"><option value="">Choose</option><option>5 - Excellent</option><option>4 - Very good</option><option>3 - Good</option><option>2 - Fair</option><option>1 - Poor</option></select></label>
<label class="block text-sm font-bold md:col-span-2">Your review<textarea required name="review" rows="6" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-normal"></textarea></label>
<label class="flex items-start gap-3 text-sm md:col-span-2"><input required type="checkbox" name="consent" value="Yes" class="mt-1"><span>I agree that Karakoram Vision Pakistan may publish my review (with my first name and country) on its website.</span></label>
<div class="md:col-span-2"><button type="submit" class="btn-primary">Submit review</button></div>
</form></div></section>
<script src="/assets/js/guest-reviews.js?v=11.0.0" defer></script>

{% set lp = landing[page.url] or {} %}

{% set heroItems = collections.journeys | keywordItems('cycle,festival,mountain pass,winter,photography,eco') | limit(6) %}{% set heroHeading = title %}{% set heroSummary = summary %}{% set heroEyebrow = lp.hero_eyebrow or 'Travel around your passion' %}{% set heroCompact = true %}
{% include "components/landing-hero.njk" %}
<section class="bk-catalog-shell"><header class="bk-section-heading"><div><p class="eyebrow">{{ lp.section_eyebrow or 'Focused journeys' }}</p><h2>{{ lp.section_heading or 'Choose an interest' }}</h2><p>{{ lp.section_intro or 'Use these categories to discover experiences beyond standard sightseeing.' }}</p></div></header><div class="bk-destination-grid">
{% set interests = (lp.cards or [
{"title":"Cycle Touring","description":"Long-distance road and valley cycling programmes","url":"/search/?type=tours&q=cycle"},
{"title":"Eco Tourism","description":"Nature, wildlife and community-conscious travel","url":"/search/?type=tours&q=eco"},
{"title":"Motorcycle Touring","description":"Scenic road journeys and high-pass routes","url":"/search/?type=tours&q=motorcycle"},
{"title":"Mountain Passes","description":"Trekking routes across high passes","url":"/search/?type=trekking&q=pass"},
{"title":"Festivals of Pakistan","description":"Cultural celebrations and seasonal events","url":"/search/?type=tours&q=festival"},
{"title":"Photography Tours","description":"Landscapes, culture and wildlife photography","url":"/search/?type=tours&q=photography"},
{"title":"Winter Adventures","description":"Snow journeys, festivals and winter landscapes","url":"/search/?type=tours&q=winter"},
{"title":"Rock Climbing","description":"Climbing routes and expedition-style support","url":"/search/?type=expeditions&q=rock%20climbing"}
]) | liveCards %}
{% for interest in interests %}<a href="{{ interest.url }}"><span>{{ loop.index }}</span><h3>{{ interest.title }}</h3><p>{{ interest.description }}</p></a>{% endfor %}</div></section>

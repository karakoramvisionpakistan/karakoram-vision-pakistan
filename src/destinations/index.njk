{% set lp = landing[page.url] or {} %}

{% set heroItems = collections.journeys | keywordItems('hunza,skardu,gilgit,chitral,kashmir,deosai') | limit(6) %}
{% set heroHeading = title %}{% set heroSummary = summary %}{% set heroEyebrow = lp.hero_eyebrow or 'Where will you go next?' %}{% set heroCompact = true %}
{% include "components/landing-hero.njk" %}
<section class="bk-catalog-shell"><header class="bk-section-heading"><div><p class="eyebrow">{{ lp.section_eyebrow or 'Explore by place' }}</p><h2>{{ lp.section_heading or 'Popular destinations' }}</h2><p>{{ lp.section_intro or 'Each destination connects to relevant tours, treks, expeditions and travel guides.' }}</p></div></header><div class="bk-destination-grid">
{% set destinations = (lp.cards or [
{"title":"Hunza","description":"Karakoram valleys, forts, villages and scenic road journeys","url":"/search/?type=all&q=hunza"},
{"title":"Skardu","description":"Gateway to K2, Baltoro, Deosai and the eastern Karakoram","url":"/search/?type=all&q=skardu"},
{"title":"Gilgit-Baltistan","description":"High-mountain travel across Pakistan’s northern regions","url":"/search/?type=all&q=gilgit"},
{"title":"Chitral & Kalash","description":"Hindu Kush valleys, festivals and cultural travel","url":"/search/?type=all&q=chitral"},
{"title":"Kashmir","description":"Alpine lakes, forest routes and mountain escapes","url":"/search/?type=all&q=kashmir"},
{"title":"Nanga Parbat Region","description":"Base camps, Fairy Meadows and Himalayan routes","url":"/search/?type=all&q=nanga%20parbat"},
{"title":"Deosai Plateau","description":"Wildlife, high plains and 4x4 journeys","url":"/search/?type=all&q=deosai"},
{"title":"Islamabad & Rawalpindi","description":"Arrival services, city tours and road-trip gateways","url":"/search/?type=all&q=islamabad"},
{"title":"Lahore & Punjab","description":"Heritage, food, architecture and cultural journeys","url":"/search/?type=all&q=lahore"}
]) | liveCards %}
{% for place in destinations %}<a href="{{ place.url }}"><span>{{ loop.index }}</span><h3>{{ place.title }}</h3><p>{{ place.description }}</p></a>{% endfor %}</div></section>

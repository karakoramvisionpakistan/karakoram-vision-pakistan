{% set lp = landing[page.url] or {} %}
{% set heroItems = collections.tours | limit(6) %}{% set heroHeading = title %}{% set heroSummary = summary %}{% set heroEyebrow = lp.hero_eyebrow or 'Choose your travel style' %}{% set heroCompact = true %}
{% include "components/landing-hero.njk" %}
<section class="bk-catalog-shell"><header class="bk-section-heading"><div><p class="eyebrow">{{ lp.section_eyebrow or 'Travel your way' }}</p><h2>{{ lp.section_heading or 'Browse by holiday style' }}</h2><p>{{ lp.section_intro or 'Start with a category, then refine by destination, duration and interests.' }}</p></div></header><div class="bk-destination-grid">
{% set types = (lp.cards or [
{"title":"Cultural Tours","description":"Heritage, food, architecture and living traditions","url":"/search/?type=tours&q=cultural"},
{"title":"Family Holidays","description":"Flexible routes and family-friendly pacing","url":"/search/?type=tours&q=family"},
{"title":"Hiking Adventures","description":"Day hikes, short treks and scenic walks","url":"/search/?type=trekking&q=hike"},
{"title":"Honeymoon Journeys","description":"Private scenic journeys and premium stays","url":"/search/?type=tours&q=honeymoon"},
{"title":"Luxury Tours","description":"Private transport, premium hotels and tailored service","url":"/search/?type=tours&q=luxury"},
{"title":"Road Trips","description":"Multi-region journeys by private vehicle","url":"/search/?type=tours&q=road%20trip"},
{"title":"Trekking Holidays","description":"Base camps, glaciers, passes and high valleys","url":"/trekking/"},
{"title":"Weekend Retreats","description":"Short escapes from major cities","url":"/search/?type=tours&q=weekend"},
{"title":"Camping","description":"Outdoor journeys and mountain camps","url":"/search/?type=tours&q=camping"}
